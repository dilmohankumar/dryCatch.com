PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/drycatch
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
# Phase 23 — SEO. STORE_NAME is used in generated titles/Organization
# structured data; SITE_URL is the canonical public origin used to build
# absolute URLs in the sitemap/canonical tags/structured data (never
# localhost in production — same "no CLIENT_URL localhost in prod" check
# Phase 21's env validation already enforces for CLIENT_URL).
STORE_NAME=DryCatch
SITE_URL=http://localhost:5173
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Which adapter services/payments/providerFactory.js resolves to. Only
# "razorpay" has real credentials/logic in this project; "stripe" is a
# structural stub (services/payments/stripeProvider.js) that fails loudly
# if ever selected, rather than pretending to work.
PAYMENT_PROVIDER=razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 10 — shipping carrier. "mock" is a fully working simulation (no
# real carrier account exists in this project); "shiprocket" is a
# structural stub, same honest-gap pattern as STRIPE_SECRET_KEY above.
SHIPPING_CARRIER=mock
MOCK_CARRIER_WEBHOOK_SECRET=mock_carrier_webhook_secret_local_dev_only
SHIPROCKET_API_KEY=
SHIPROCKET_API_SECRET=

# Phase 12 — reviews. REQUIRE_PURCHASE=true (default) means a customer must
# have a paid order containing the product to review it at all; "false"
# allows any authenticated customer, with isVerifiedPurchase as a badge only.
# MODERATION_MODE=auto (default) publishes reviews immediately; "manual"
# requires an admin approval step first.
REVIEW_REQUIRE_PURCHASE=true
REVIEW_MODERATION_MODE=auto

# Phase 13 — search. "mongo" is a fully working MVP provider (Mongo $text
# index); "opensearch" is a structural stub (no cluster configured).
SEARCH_PROVIDER=mongo

# Phase 14 — admin bootstrap. Set both to create the very first SUPER_ADMIN
# on boot (no-op if any admin user already exists, or if unset). Admins
# after that are created only via invite (see docs/admin.md).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
